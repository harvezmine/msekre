{
  "expo": {
    "name": "Sekretaris AI",
    "slug": "sekretaris-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "sekretarisai",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F6F6F0",
    "android": {
      "package": "id.my.secretary.dev",
      "adaptiveIcon": {
        "backgroundColor": "#F6F6F0",
        "foregroundImage": "./assets/brand/icon-foreground.png",
        "monochromeImage": "./assets/brand/icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/brand/s-mark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/s-mark.png",
          "imageWidth": 120,
          "backgroundColor": "#F6F6F0",
          "dark": {
            "image": "./assets/brand/s-ribbon-light.png",
            "backgroundColor": "#0A1F18"
          }
        }
      ],
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
